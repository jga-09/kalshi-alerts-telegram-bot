# =============================================================================
# Kalshi AI - environment configuration
# Copy to .env and fill in. NEVER commit .env or any real secret.
# Generate secrets with:  python scripts/manage.py gen-secrets
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DOMAIN=                             # e.g. app.example.com (enables Caddy HTTPS profile)

# --- Security (REQUIRED in production) ---------------------------------------
JWT_SECRET=                         # >= 32 random chars
# Comma-separated Fernet keys; first encrypts, all decrypt (rotate by prepending a new key).
ENCRYPTION_KEYS=
CODE_HASH_PEPPER=                   # random string; changing it invalidates existing access codes
INTERNAL_API_TOKEN=                 # random string
# Telegram IDs allowed to be admins. A user ALSO needs role=admin in the DB:
#   python scripts/manage.py grant-admin <telegram_id>
ADMIN_TELEGRAM_IDS=
ACTIVATION_MAX_ATTEMPTS=5
ACTIVATION_WINDOW_SECONDS=900
API_RATE_LIMIT_PER_MINUTE=120

# --- Infrastructure ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://kalshi:kalshi@localhost:5432/kalshi_ai
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=                  # defaults to REDIS_URL
POSTGRES_USER=kalshi
POSTGRES_PASSWORD=kalshi            # change for any non-local deployment
POSTGRES_DB=kalshi_ai

# --- Telegram (https://t.me/BotFather -> /newbot) ----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KalshiAIBot
TELEGRAM_WEBHOOK_URL=               # optional: https://<DOMAIN>/telegram/webhook (polling if empty)
TELEGRAM_WEBHOOK_SECRET=            # random string, verified on every webhook call

# --- Stripe (https://dashboard.stripe.com/apikeys, Developers -> Webhooks) ---
STRIPE_SECRET_KEY=                  # sk_test_... / sk_live_... (restricted key recommended)
STRIPE_WEBHOOK_SECRET=              # whsec_... from the webhook endpoint
STRIPE_TRIAL_DAYS=0                 # >0 enables free trials on new subscriptions
# Price IDs (Products -> Prices). Prices can also be managed in the DB via PUT /api/admin/plans.
STRIPE_PRICE_SIGNALS_MONTHLY=
STRIPE_PRICE_SIGNALS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_AUTO_MONTHLY=
STRIPE_PRICE_AUTO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# --- Kalshi ------------------------------------------------------------------
# No platform Kalshi credentials are needed: market data endpoints are public and each
# customer connects their OWN API key (encrypted at rest) via /connect.
KALSHI_ENV=demo                     # demo | prod  (start with demo!)
KALSHI_REST_BASE_URL=               # override; defaults to the official host for KALSHI_ENV
KALSHI_WS_URL=
KALSHI_TIMEOUT_SECONDS=10
KALSHI_MAX_RETRIES=2
KALSHI_ALLOW_TRANSFER_SCOPE=false   # keep false: reject keys that can move funds
FEATURED_SERIES=KXBTC15M,KXBTCD,KXETH15M,KXGOLDD   # verify current series tickers on kalshi.com

# --- Data sources (all optional; missing sources lower confidence) ----------
NEWS_API_KEY=                       # https://newsapi.org (check license for commercial use)
FRED_API_KEY=                       # https://fred.stlouisfed.org/docs/api/api_key.html
REDDIT_CLIENT_ID=                   # https://www.reddit.com/prefs/apps (script/app type; review Data API terms)
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=kalshi-ai/0.1 (contact: admin@example.com)
X_BEARER_TOKEN=                     # https://developer.x.com (paid tier required for search)
RSS_FEEDS=                          # comma-separated publisher RSS URLs you are permitted to use
DERIBIT_ENABLED=false               # public derivatives data; confirm availability in your jurisdiction
GOLD_DATA_PROVIDER=                 # licensed gold/GC data adapter name (not bundled)
ECONOMIC_CALENDAR_PATH=scripts/economic_calendar.json

# --- Optional LLM qualitative analysis (never places orders) ----------------
LLM_ENABLED=false
ANTHROPIC_API_KEY=                  # https://console.anthropic.com
LLM_MODEL=claude-opus-5-5

# --- Trading defaults ---------------------------------------------------------
PAPER_TRADING=true                  # paper trading is the default
LIVE_TRADING=false                  # platform-wide master switch for live orders
MIN_EDGE=0.05
MAX_POSITION_SIZE=50                # contracts per market (platform cap)
MAX_DAILY_LOSS=50                   # USD per user per day (platform cap)
MAX_DATA_AGE_SECONDS=120
PAPER_STARTING_BALANCE=1000
# RISK_PROFILES_JSON={"low": {"max_daily_loss": "5"}}   # optional profile overrides

# --- Hard global limits (no user can exceed these) ---------------------------
HARD_MAX_ORDER_CONTRACTS=500
HARD_MAX_ORDER_NOTIONAL_USD=250
HARD_MAX_DAILY_LOSS_USD=500
HARD_MAX_TRADES_PER_DAY=100
HARD_MIN_EDGE=0.02
HARD_MIN_CONFIDENCE=0.50
HARD_MAX_SPREAD=0.10
HARD_MIN_TOP_OF_BOOK_DEPTH=10
HARD_MAX_MARKET_EXPOSURE_USD=1000
HARD_MIN_PRICE=0.02
HARD_MAX_PRICE=0.98
